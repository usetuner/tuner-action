{
  "name": "tuner-action",
  "version": "0.0.0",
  "private": true,
  "description": "Run Tuner voice-agent simulations in GitHub Actions",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check-dist": "npm run build && git diff --exit-code -- dist"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
